# After `docker compose up`, sign in at /auth/login as admin:
#   Email: admin@ready2cook.co.uk   Password: Admin12345
#
# Loaded by Docker Compose for the Next.js container. Extend with Stripe, OAuth,
# SMTP, Cloudinary etc. Copy from `.env.example` as needed — same variable names.

# Must match browser URL — default port is 3001 (see HOST_PORT in docker-compose.yml).
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=local-dev-change-me-at-least-32-characters-long
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
